set(CMAKE_SYSTEM_NAME               Generic)
set(CMAKE_SYSTEM_PROCESSOR          arm)

# IAR Embedded Workbench for Arm tools must be available in PATH.
set(TOOLCHAIN_FOLDER                c:/iar/ewarm-9.70.4/arm/bin)

set(CMAKE_C_COMPILER                ${TOOLCHAIN_FOLDER}/iccarm.exe)
set(CMAKE_ASM_COMPILER              ${TOOLCHAIN_FOLDER}/iasmarm.exe)
set(CMAKE_CXX_COMPILER              ${TOOLCHAIN_FOLDER}/iccarm.exe)
set(CMAKE_LINKER                    ${TOOLCHAIN_FOLDER}/ilinkarm.exe)
set(CMAKE_OBJCOPY                   ${TOOLCHAIN_FOLDER}/ielftool.exe)
set(CMAKE_PYTHON_NM                  map2symbol.py)

set(CPU_FLAGS)
if(CPU STREQUAL "Cortex-M0")
  set(CPU_FLAGS  --cpu=cortex-m0)
elseif(CPU STREQUAL "Cortex-M0+")
  set(CPU_FLAGS --cpu=cortex-m0plus)
elseif(CPU STREQUAL "Cortex-M1")
  set(CPU_FLAGS --cpu=cortex-m1)
elseif(CPU STREQUAL "Cortex-M3")
  set(CPU_FLAGS --cpu=cortex-m3)
elseif(CPU STREQUAL "Cortex-M4")
 set(CPU_FLAGS --cpu=cortex-m4)
elseif(CPU STREQUAL "Cortex-M23")
 set(CPU_FLAGS --cpu=cortex-m23)
elseif(CPU STREQUAL "Cortex-M33")
 set(CPU_FLAGS --cpu=cortex-m33)
elseif(CPU STREQUAL "Cortex-M35P")
 set(CPU_FLAGS --cpu=cortex-m35p)
elseif(CPU STREQUAL "Cortex-M55")
 set(CPU_FLAGS --cpu=cortex-m55)
elseif(CPU STREQUAL "Cortex-M85")
 set(CPU_FLAGS --cpu=cortex-m85)
else()
  message(FATAL_ERROR "Unsupported IAR CPU: ${CPU}")
endif()

if(FPU STREQUAL "SP_FPU")
  if(CPU STREQUAL "Cortex-M4")
    list(APPEND CPU_FLAGS --fpu=VFPv4_sp)
  elseif(CPU STREQUAL "Cortex-M7" OR CPU STREQUAL "Cortex-M33" OR
         CPU STREQUAL "Cortex-M35P" OR CPU STREQUAL "Cortex-M55" OR
         CPU STREQUAL "Cortex-M85")
    list(APPEND CPU_FLAGS --fpu=VFPv5_sp)
  else()
    message(FATAL_ERROR "${FPU} is not supported for ${CPU}")
  endif()
elseif(FPU STREQUAL "DP_FPU")
  if(CPU STREQUAL "Cortex-M7")
    list(APPEND CPU_FLAGS --fpu=VFPv5_d16)
  elseif(CPU STREQUAL "Cortex-M55" OR CPU STREQUAL "Cortex-M85")
    list(APPEND CPU_FLAGS --fpu=VFPv5_d16)
  else()
    message(FATAL_ERROR "${FPU} is not supported for ${CPU}")
  endif()
elseif(FPU STREQUAL "NO_FPU")
  list(APPEND CPU_FLAGS --fpu=None)
elseif(FPU)
  message(FATAL_ERROR "Unsupported IAR FPU setting: ${FPU}")
endif()

if(BYTE_ORDER STREQUAL "Little-endian" OR CMSIS_Dendian STREQUAL "Little-endian")
  list(APPEND CPU_FLAGS --endian=little)
elseif(BYTE_ORDER STREQUAL "Big-endian" OR CMSIS_Dendian STREQUAL "Big-endian")
  list(APPEND CPU_FLAGS --endian=big)
endif()

if(SECURE STREQUAL "Secure" OR SECURE STREQUAL "Secure-only")
  set(CC_SECURE --cmse)
endif()

set(CMAKE_C_FLAGS                   "--debug")
set(CMAKE_CXX_FLAGS                 "--debug --c++")
set(CMAKE_EXECUTABLE_SUFFIX         ".out")
set(CMAKE_TRY_COMPILE_TARGET_TYPE   STATIC_LIBRARY)